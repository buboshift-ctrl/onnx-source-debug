+  std::optional<Location> ParseStackTrace(const std::string &trace) {
+    size_t q1 = trace.find('"');
+    if (q1 == std::string::npos)
+      return std::nullopt;
+    size_t q2 = trace.find('"', q1 + 1);
+    if (q2 == std::string::npos)
+      return std::nullopt;
+    std::string file = trace.substr(q1 + 1, q2 - q1 - 1);
+
+    const std::string kLine = ", line ";
+    size_t lp = trace.find(kLine, q2);
+    if (lp == std::string::npos)
+      return std::nullopt;
+    lp += kLine.size();
+
+    unsigned line = 0;
+    while (lp < trace.size() && isdigit(trace[lp]))
+      line = line * 10 + (trace[lp++] - '0');
+    if (line == 0)
+      return std::nullopt;
+
+    return FileLineColLoc::get(
+        builder_.getStringAttr(file), line, /*column=*/0);
+  }
